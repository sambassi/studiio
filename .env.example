# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# NextAuth v5
AUTH_SECRET=your_auth_secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth (for login + YouTube)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook/Instagram OAuth (Meta Graph API v24.0)
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
META_INSTAGRAM_APP_ID=your_meta_instagram_app_id
META_INSTAGRAM_APP_SECRET=your_meta_instagram_app_secret

# TikTok (Content Posting API v2)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# YouTube (Data API v3) - can reuse Google credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Anthropic (AI card generation)
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI (TTS — natural-voice alternative to Edge TTS)
OPENAI_API_KEY=your_openai_api_key

# Admin Secret
ADMIN_SECRET_KEY=your_admin_secret_key

# ── Canal WhatsApp (Meta WhatsApp Cloud API) ──────────────────────────────
# SECRET — jamais en dur dans le code, jamais renvoye au navigateur.
# Sans ce token, le canal WhatsApp reste « Bientot disponible » dans l'UI.
STUDIIO_WHATSAPP_TOKEN=

# Numero unique de repli, au format libre (0791234567, +41791234567...).
# Sert a l'auto-test quand un post ne definit pas metadata.whatsappTo.
WHATSAPP_DEFAULT_RECIPIENT=

# Identifiants NON secrets — surcharges optionnelles si le compte Meta change.
# Defauts : 1062611940271584 / 1615280896432370 / v21.0 / afroboost_campagne / fr
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_API_VERSION=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=

# ── Listes d'abonnes opt-in (afroboost) ───────────────────────────────────
# SECRET — cle d'acces a l'API de listes. Sans elle, aucune diffusion : le
# canal retombe sur l'auto-test (WHATSAPP_DEFAULT_RECIPIENT / auteur du post).
AFROBOOST_LIST_API_KEY=

# Endpoint des listes. Defaut : https://afroboost.com/api/subscribers
# Interroge en GET avec ?channel=whatsapp ou ?channel=email, reponse
# { "list": [...] }. Relu AVANT CHAQUE ENVOI, sans cache, pour respecter
# les desabonnements (STOP) immediatement.
# L'origine de cette URL sert aussi a construire le lien de desabonnement
# WhatsApp, et POST {origine}/unsubscribe recoit le relai des desabonnements
# email (best-effort : la source de verite est la table email_suppressions).
AFROBOOST_LIST_API_URL=https://afroboost.com/api/subscribers

# ── Email / delivrabilite ─────────────────────────────────────────────────
# EXPEDITEUR — doit etre le domaine dont SPF/DKIM/DMARC sont alignes chez
# Resend, sinon les emails partent en spam. Aucun `from` n'est ecrit en dur
# dans le code : cette variable est le seul point de reglage.
RESEND_FROM=Afroboost <notifications@afroboost.com>
RESEND_API_KEY=

# Adresse de reponse REELLE et surveillee. Un Reply-To mort (ou absent)
# degrade la reputation. Non definie = aucun Reply-To (comportement d'avant).
RESEND_REPLY_TO=contact@afroboost.ch

# Signature des liens de desabonnement un-clic. Optionnel : `AUTH_SECRET` est
# utilise par defaut. Ne la changer que pour invalider tous les liens deja
# envoyes.
# UNSUBSCRIBE_SECRET=

# NOTE — l'URL de desabonnement est derivee de NEXT_PUBLIC_APP_URL :
#   POST {NEXT_PUBLIC_APP_URL}/api/email/unsubscribe?e=<adresse>&t=<jeton>
# Elle doit etre publiquement joignable et repondre 200, sinon Gmail
# considere l'en-tete List-Unsubscribe comme invalide.
